# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Intermediate research pickles (regenerated by research/phase2/phase2_a_*.py)
*.pkl

# Scratch intermediates and run logs from research/phase2
outputs/phase2/_*

# Run artefacts
logs/
*.part
data/staging/
data/model/*.db

# The one time-dependent ingestion file (records platform and wall-clock time); everything else in outputs/ingestion is deterministic
outputs/ingestion/ingestion_run.json

# Large regenerable staging tables (the summaries and reconciliations next to them ARE tracked)
outputs/staging/stg_*.csv

# NOTE: data/raw/ is committed on purpose. It is small (about 4 MB), immutable, and lets the pipeline run
# fully offline. Do not ignore it. Refreshed snapshots (data/raw/*/refresh-*/) are untracked until adopted deliberately.
